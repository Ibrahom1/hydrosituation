# Example environment file for Hydrological Situation Dashboard
# Copy to .env and fill in your real values. Do NOT commit your .env.

# Required: FFD API key used for pm-dashboard POST endpoint
FFD_API_KEY=REPLACE_WITH_REAL_FFD_KEY

# Optional: override backend listening port (default 5000)
# PORT=5000

# Optional: remote dataset URL (raw latest.json) if you want backend to pull from external source
# REMOTE_DATA_URL=https://raw.githubusercontent.com/your-user/your-dataset-repo/main/latest.json

# Optional: adjust scheduler interval (hours) if you modify code to read it
# SCHEDULER_HOURS=6
